<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context="com.example.uiprototype.ui.HomeActivity">
    <!-- MAIN CONTENT -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:backgroundTint="@color/colorPrimary"
            android:title="Locker Rental System"
            android:titleTextColor="@android:color/white"
            android:elevation="8dp"
            app:navigationIcon="@drawable/ic_menu"
            app:menu="@menu/topbar_menu"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:id="@+id/homeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/colorText"
            app:layout_constraintTop_toBottomOf="@id/topAppBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="80dp"/>

        <TextView
            android:id="@+id/homeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manage_locker_subtitle"
            android:textSize="16sp"
            android:textColor="@color/colorText"
            app:layout_constraintTop_toBottomOf="@id/homeTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRentLocker"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/rent_locker"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/colorSecondary"
            android:paddingVertical="14dp"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/homeSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="60dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewLocker"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/view_locker"
            android:textSize="18sp"
            android:textStyle="bold"
            app:strokeColor="@color/colorSecondary"
            app:strokeWidth="2dp"
            app:cornerRadius="12dp"
            android:textColor="@color/colorSecondary"
            android:paddingVertical="14dp"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            app:layout_constraintTop_toBottomOf="@id/btnRentLocker"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccessActivity"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/access_activity_demo"
            android:textSize="16sp"
            android:textColor="@color/colorSecondary"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/btnViewLocker"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/nav_menu"
        android:background="#1F1F1F"
        app:itemTextColor="#FFFFFF"
        app:itemIconTint="#FFFFFF"/>
</androidx.drawerlayout.widget.DrawerLayout>
