<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/detailsToolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:title="Locker Details"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/ic_back" />

    <TextView
        android:id="@+id/detailLockerId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Locker #101"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#2A2340"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/detailLockerSize"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Size: Medium"
        android:textSize="18sp"
        android:textColor="#5B5670"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/detailLockerId"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/detailLockerLocation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Location: Level 2 – Aisle 4"
        android:textSize="18sp"
        android:textColor="#5B5670"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/detailLockerSize"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/detailLockerStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Available"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#2ECC71"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/detailLockerLocation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/detailLockerUser"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Rented By: Nobody"
        android:textSize="16sp"
        android:textColor="#5B5670"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/detailLockerStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/detailLockerButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="Rent"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/bg_button_purple"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/detailLockerUser"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
