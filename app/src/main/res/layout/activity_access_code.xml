<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@drawable/bg_gradient"
    tools:context=".ui.AccessActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardAccessInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnBackHome"
        app:cardBackgroundColor="@color/glassCard"
        app:cardUseCompatPadding="true"
        android:layout_marginTop="100dp"
        android:layout_marginBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/textLockerId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Locker #100"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/colorText"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/textAccessCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/access_code_prefix"
                android:textSize="20sp"
                android:textColor="@color/colorText"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/textTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/expires_in"
                android:textSize="18sp"
                android:textColor="@color/colorSecondary"
                android:layout_marginBottom="8dp"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Better button styling -->
    <Button
        android:id="@+id/btnBackHome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/back_home"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/colorSecondary"
        android:paddingVertical="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"

        android:layout_marginBottom="40dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
